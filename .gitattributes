# Normalise line endings so the repo stays consistent across Windows and Linux.
* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.md     text eol=lf

*.jar    binary
*.png    binary
*.jpg    binary

# Windows batch files keep CRLF — a .cmd checked out with LF endings is a
# script cmd.exe can mis-parse. The wrapper's shell twin stays LF, which is
# what the Linux CI runner needs to execute it at all.
*.cmd    text eol=crlf
*.bat    text eol=crlf
