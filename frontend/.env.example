# Where the dev server proxies /api/* to.
#
# Must match the host port docker-compose.yml publishes for the app, which is
# SERVER_PORT in the repository's root .env — 8080 unless that machine already
# has something on 8080.
#
# Copy to .env.local (git-ignored) and edit if yours differs.
VITE_API_TARGET=http://localhost:8080
