# Copy to .env and fill in real values. .env is gitignored and must never be committed.
# These are placeholders, not defaults — application.yml deliberately has no fallbacks
# for secrets (rules.md 2.5).

# Database
POSTGRES_DB=ledger_wallet
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Host port the database container publishes on. Change this if something else on
# your machine already listens on 5432 (a native PostgreSQL install, for example) —
# otherwise a local `mvn spring-boot:run` may reach that server instead of the
# container. Only affects the host side; inside compose the app uses db:5432.
DB_HOST_PORT=5432

# Application
SERVER_PORT=8080

# Added in Phase 2, when JWT authentication arrives.
# Use a long random value, not a passphrase.
# JWT_SECRET=CHANGE_ME
