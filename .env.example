# Copy to .env and fill in real values. .env is gitignored and must never be committed.
# These are placeholders, not defaults — application.yml deliberately has no fallbacks
# for secrets (rules.md 2.5).

# Database
POSTGRES_DB=ledger_wallet
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Application
SERVER_PORT=8080

# Added in Phase 2, when JWT authentication arrives.
# Use a long random value, not a passphrase.
# JWT_SECRET=CHANGE_ME
